# Plantilla de variables para docker compose. NO contiene secretos.
# Genera tu .env con valores aleatorios:   ./scripts/init-env.sh
# .env nunca se commitea. En Azure los secretos viven en Key Vault (ADR-0006).

# Secreto para firmar los JWT (Base64, mínimo 32 bytes):  openssl rand -base64 48
JWT_SECRET=

# Cuenta admin creada al arrancar (nadie puede registrarse como admin)
ADMIN_EMAIL=admin@polla.local
ADMIN_PASSWORD=

# Participantes demo con predicciones (ana@, carlos@, valentina@, diego@polla.local)
DEMO_DATA=true
DEMO_PASSWORD=

# Base de datos local del compose
DB_USERNAME=polla
DB_PASSWORD=

# false solo para http://localhost. En producción (HTTPS) debe ser true.
COOKIE_SECURE=false
