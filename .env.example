# Copia este archivo a .env y ajusta los valores. .env NUNCA se commitea.

# Secreto para firmar los JWT (Base64, mínimo 32 bytes). Este valor es SOLO para desarrollo local.
# En producción genera uno nuevo con:  openssl rand -base64 48
JWT_SECRET=AMtCQoVYuNe8bIzrgoNhAGamxtG0hVJV0HpANWFmH/L8DuenRrrmlBRAB+i1+1je

# Cuenta admin creada al arrancar (nadie puede registrarse como admin)
ADMIN_EMAIL=admin@polla.local
ADMIN_PASSWORD=Admin12345

# Participantes demo con predicciones (ana@, carlos@, valentina@, diego@polla.local)
DEMO_DATA=true
DEMO_PASSWORD=Usuario123

# Base de datos
DB_USERNAME=polla
DB_PASSWORD=polla

# false solo para http://localhost. En producción (HTTPS) debe ser true.
COOKIE_SECURE=false
